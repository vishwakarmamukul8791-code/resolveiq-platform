# Application environment: development or production.
ENVIRONMENT=development

# Required for Gemini answer generation.
GEMINI_API_KEY=your_gemini_api_key

# Required for login and JWT authentication.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_signing_secret

# Optional: comma-separated deployed frontend origins allowed by CORS.
# Example:
# FRONTEND_ORIGIN=https://resolveiq.example.com
FRONTEND_ORIGIN=

# Optional: enable admin-only retrieval debugging during local development.
# Keep false in production.
ENABLE_DEBUG_ROUTES=false

# Embedding configuration.
# Local development uses SentenceTransformers.
# Render Free uses Gemini embeddings to reduce memory usage.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=384

# Disable on memory-constrained production instances.
ENABLE_CROSS_ENCODER=true

# First-admin bootstrap for deployments.
# Keep the password only in the hosting provider's secret environment.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
