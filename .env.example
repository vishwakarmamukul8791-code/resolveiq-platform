# Application environment: development or production.
ENVIRONMENT=development

# Required for Gemini answer generation.
GEMINI_API_KEY=your_gemini_api_key

# Required for login and JWT authentication.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_signing_secret

# Persistence backend. Use local for development and Supabase in production.
PERSISTENCE_BACKEND=local

# Local-only runtime state directory (users, sessions, uploads, metadata,
# and FAISS). Render production does not use this as durable storage.
DATA_DIR=data

# Required when PERSISTENCE_BACKEND=supabase.
# On Render Free, use the Supabase Session pooler URL (IPv4, port 5432).
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resolveiq-documents

# Maximum accepted PDF/CSV/TXT upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Optional: comma-separated deployed frontend origins allowed by CORS.
# Example:
# FRONTEND_ORIGIN=https://resolveiq.example.com
FRONTEND_ORIGIN=

# Optional: enable admin-only retrieval debugging during local development.
# Keep false in production.
ENABLE_DEBUG_ROUTES=false

# Embedding configuration.
# Local development uses SentenceTransformers.
# Render Free uses Gemini embeddings to reduce memory usage.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=384

# Disable on memory-constrained production instances.
ENABLE_CROSS_ENCODER=true

# First-admin bootstrap for deployments.
# Keep the password only in the hosting provider's secret environment.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET_VERSION=
